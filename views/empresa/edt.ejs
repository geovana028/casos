<%- include('../cabecalho.ejs') %>
    <h1>Editar Dados da Empresa</h1>
    <div>
        <a href="/caso/lst">Listar</a>
    </div>
    <div>
        <form method="post">

            <input type="hidden" name="id" value="<%=Caso.id%>"><br>
            <label>Empresa:</label>
            <input type="text" name="nome" value="<%=Caso.nome%>"><br>
            <label>Área:</label>
            <input type="text" name="area" value="<%=Caso.area%>"><br>
            <label>Ano de Fundação:</label>
            <input type="text" name="anofundacao" value="<%=Caso.anofundacao%>"><br>
            <label>CPNJ:</label>
            <input type="text" name="cnpj" value="<%=Caso.cnpj%>"><br>
            <label>Logo ou Foto da Empresa:</label>
            <input type="text" name="logo" value="<%=Caso.logo%>"><br>

            <button type="submit">Cadastrar</button>

        </form>
    </div>

    <%- include('../rodape.ejs') %>