<%- include('../cabecalho.ejs') %>
    <h1>Editar Julgamento</h1>
    <div>
        <a href="/julgamento/lst">Listar</a>
    </div>
    <div>
        <form method="post">

            <input type="hidden" name="id" value="<%=Julgamento.id%>"><br>
            <label>Nome:</label>
            <input type="text" name="nome" value="<%=Julgamento.nome%>"><br>
            <label>Área:</label>
            <input type="text" name="area" value="<%=Julgamento.area%>"><br>
            <label>Ano de Fundação:</label>
            <input type="number" name="anofundacao" value="<%=Julgamento.anofundacao%>"><br>
            <label>Data do Julgamento:</label>
            <input type="date" name="datadojulgamento" value="<%= new Date(Julgamento.datadojulgamento).toISOString().slice(0, 10) %>"><br>
            <label>Valor da Indenização:</label>
            <input type="number" step="0.01" min="0" name="valorindenizacao" value="<%=Julgamento.valorindenizacao ?? 0%>"><br>
            
            <button type="submit">Salvar</button>

        </form>
    </div>

    <%- include('../rodape.ejs') %>
