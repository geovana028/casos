<%- include('../cabecalho.ejs') %>
    <h1>Julgamentos</h1>
    <a href="/julgamento/add">+ Julgamento</a>
    <table>
        <tr>
            <td>Empresa</td>
            <td>Data do Julgamento</td>
            <td>Valor da Indenização</td>
            <td>Ações</td>
        </tr>

        <% for (const julgamento of julgamentos) { %>
            <tr>
                <td>
                    <%= julgamento.nome %>
                </td>
                <td>
                    <%= new Date(julgamento.datadojulgamento).toLocaleDateString('pt-BR') %>
                </td>
                <td>
                    <%= Number(julgamento.valorindenizacao ?? 0).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' }) %>
                </td>
                <td>
                    <a href="/julgamento/edit/<%= julgamento.id %>">Editar</a>
                    <a href="/julgamento/delete/<%= julgamento.id %>">Excluir</a>
                </td>
            </tr>
            <% } %>
    </table>
    <%- include('../rodape.ejs') %>