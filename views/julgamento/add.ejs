<%- include('../cabecalho.ejs') %>
    <h1>Cadastrar Julgamento</h1>
    <div>
        <a href="/julgamento/lst">Listar</a>
    </div>
    <div>
        <form method="post">
            <label>Nome:</label>
            <input type="text" name="nome"><br>
            <label>Data do Julgamento:</label>
            <input type="date" name="datadojulgamento"><br>
            <label>Valor da Indenização:</label>
            <input type="number" step="0.01" min="0" name="valorindenizacao"><br>
            <button type="submit">Cadastrar</button>

        </form>
    </div>

    <%- include('../rodape.ejs') %>