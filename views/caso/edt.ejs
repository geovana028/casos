<%-include('.. /cabecalho.ejs')%>
    <h1>Editar Caso</h1>
    <div>
        <a href="/caso/lst">Listar</a>
    </div>
    <div>
        <form method="post">

            <input type="hidden" name="id" value="<%=Caso.id%>"><br>
            <label>Descrição:</label>
            <input type="text" name="descricao" value="<%=Caso.descricao%>"><br>
            <label>Tipo do Crime:</label>
            <input type="text" name="tipodocrime" value="<%=Caso.tipodocrime%>"><br>
            <label>Local:</label>
            <input type="text" name="local" value="<%=Caso.local%>"><br>
            <button type="submit">Cadastrar</button>

        </form>
    </div>

    <%-include('.. /rodape.ejs')%>