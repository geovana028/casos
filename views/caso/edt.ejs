<%- include('../cabecalho.ejs') %>
    <h1>Editar Caso</h1>
    <div>
        <a href="/caso/lst">Listar</a>
    </div>
    <div>
        <form method="post">

            <input type="hidden" name="id" value="<%=Caso.id%>"><br>
            <label>Descrição do Processo:</label>
            <input type="text" name="descricaodoprocesso" value="<%=Caso.descricaodoprocesso%>"><br>
            <label> Tipo do Produto</label>
            <input type="text" name="tipodoproduto" value="<%=Caso.tipodoproduto%>"><br>


            <button type="submit">Cadastrar</button>

        </form>
    </div>

    <%- include('../rodape.ejs') %>