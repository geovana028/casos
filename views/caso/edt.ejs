<%- include('../cabecalho.ejs') %>
<h1>Editar Caso</h1>
<div>
    <a href="/caso/lst">Listar</a>
</div>
<div>
    <form method="post" enctype="multipart/form-data">
        <input type="hidden" name="id" value="<%= Caso && Caso._id ? Caso._id : '' %>"><br>

        <label>Descrição do Processo:</label>
        <input type="text" name="descricaodoprocesso" value="<%= Caso ? Caso.descricaodoprocesso : '' %>"><br>

        <label>Tipo do Processo:</label>
        <input type="text" name="tipodoprocesso" value="<%= Caso ? Caso.tipodoprocesso : '' %>"><br>

        <label>Marca:</label>
        <input type="text" name="marca" value="<%= Caso ? Caso.marca : '' %>"><br>

        <label>Foto:</label>
        <input type="file" name="foto"><br>

        <button type="submit">Salvar</button>
    </form>
</div>
<%- include('../rodape.ejs') %>