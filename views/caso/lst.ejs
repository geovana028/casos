<%- include('../cabecalho.ejs')%>
    <h1>Casos</h1>
    <div>
        <form action="
        " method="post">
            <input type="text" name="filtro" id="" placeholder="digite o nome">
            <button type="submit">Pesquisar</button>
        </form>
    </div>
    <a href="/caso/add">+ Caso</a>
    <table>
        <tr>
            <td>Descrição do Processo</td>
            <td>Tipo do Produto</td>
            <td>Foto</td>
            <td>Ações</td>
        </tr>

        <% for (const caso of Casos) { %>
            <tr>
                <td>
                    <%= caso.descricaodoprocesso %>
                </td>
                <td>
                    <%= caso.tipodoprocesso %>
                </td>
                <td>
                    <% if (caso.foto) { %>
                        <img src="<%= caso.foto %>" alt="Foto" style="width: 100px; height: 100px; object-fit: cover;">
                    <% } else { %>
                        Sem foto
                    <% } %>
                </td>
                <td>
                    <a href="/caso/edt/<%= caso.id %>">Editar</a>
                    <a href="/caso/del/<%= caso.id %>">Excluir</a>
                </td>
            </tr>
            <% } %>
    </table>
    <%- include('../rodape.ejs')%>