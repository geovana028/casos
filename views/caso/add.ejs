<%- include('../cabecalho.ejs') %>
<h1>Adicionar Caso</h1>
<div>
    <a href="/caso/lst">Listar</a>
</div>
<div>
    <form method="post" enctype="multipart/form-data">
        <label>Descrição do Processo:</label>
        <input type="text" name="descricaodoprocesso"><br>
        
        <label>Tipo do Produto:</label>
        <input type="text" name="tipodoprocesso"><br>

        <label>Marca:</label>
        <input type="text" name="marca"><br>

        <!-- Campo para envio de arquivo adicionado abaixo -->
        <label for="foto">Foto do Produto:</label>
        <input type="file" id="foto" name="foto"><br>
        
        <button type="submit">Cadastrar</button>
    </form>
</div>
<%- include('../rodape.ejs') %>